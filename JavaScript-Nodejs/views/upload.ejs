<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Audit Bundle Upload - Zip Slip Exploration</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="navbar"><div class="container nav-container">
    <a class="brand" href="/upload_bundle"><span class="brand-badge">ZIP</span><span>Archive Upload Lab</span></a>
    <ul class="nav-links"><li><a class="nav-link" href="/upload_bundle">Upload Bundle</a></li></ul>
  </div></header>
  <main class="main-content"><div class="container">
    <div class="page-header"><h1 class="page-title">Audit Bundle Ingestion Center</h1><p class="page-subtitle">Upload zipped bundles containing audit assets, template fragments, and reporting logs.</p></div>
    <div class="grid">
      <div class="card"><h3 class="card-title">📦 Upload Audit Archive (.zip)</h3>
        <form method="POST" action="/upload_bundle" enctype="multipart/form-data">
          <div class="form-group"><label class="form-label">Select ZIP Bundle:</label><input type="file" name="bundle" accept=".zip" class="form-input" required></div>
          <button type="submit" class="btn btn-primary">🚀 Upload &amp; Unpack Bundle</button>
        </form>
        <div class="note"><h4>💡 Zip Slip Architecture Note:</h4><p>The extraction directory is <code>app/storage/temp_extract/</code>. Archive entries containing relative directory traversals are written without canonicalization.</p></div>
      </div>
      <div class="card"><h3 class="card-title">📋 Extraction Log &amp; Status</h3>
        <% if (message) { %><div class="alert alert-<%= status %>"><%= message %></div><% } %>
        <% if (extractedFiles.length) { %><table class="data-table"><thead><tr><th>Archive Path</th><th>Size</th><th>Target Destination</th></tr></thead><tbody>
          <% extractedFiles.forEach(item => { %><tr><td><code class="badge badge-warning"><%= item.filename %></code></td><td><%= item.size %> B</td><td><code><%= item.resolvedDest %></code></td></tr><% }) %>
        </tbody></table><% } else { %><div class="empty">No bundle processed yet. Upload a valid <code>.zip</code> file to inspect extraction output.</div><% } %>
      </div>
    </div>
  </div></main>
</body>
</html>
